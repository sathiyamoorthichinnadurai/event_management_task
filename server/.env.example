PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/event-management
JWT_SECRET=your_strong_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Secret key required to register a new admin account via POST /api/auth/register/admin
# Generate a strong random string (e.g. openssl rand -hex 32) and set it here.
# Never commit the real value — keep it only in your production secrets manager.
#use this for admin register as secret key
ADMIN_REGISTRATION_SECRET=admin_reg_secret_2026_change_in_prod
